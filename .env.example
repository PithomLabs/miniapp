# Example local development settings. Copy nothing secret here.
# Real values live in the owner-only secrets dir managed by
# scripts/dev/local-secrets-init.sh. This file documents non-secret
# knobs only; every value below is a safe default.

# Official PostgreSQL image tag (verified stable GA at selection time).
POSTGRES_IMAGE=postgres:19.0
# Must match the image major version; startup refuses on mismatch.
POSTGRES_MAJOR=19
# Local role and database created by the official image entrypoint.
POSTGRES_USER=miniapp
POSTGRES_DB=miniapp_dev
# Optional host port for local tools (loopback only, via compose.host.yaml).
MINIAPP_DB_HOST_PORT=5433
